  "title": "İhracat ve Döviz Kazandırıcı Hizmetler Reeskont Kredilerine İlişkin Basın Duyurusu (2023-34)",
  "announcement_number": "2023-34",
  "published_date": "2023-09-12",
  "date_source": "body",
