  "title": "Kredi Kartı İşlemlerinde 2020 Yılı Birinci Çeyreğinde Uygulanacak Azami Faiz Oranlarına İlişkin Basın Duyurusu (2019-51)",
  "announcement_number": "2019-51",
  "published_date": "2019-12-28",
